# Supabase (Vercel / local Vite)
# Project Settings → API
#
# VITE_SUPABASE_URL = Project URL เช่น https://abcdxyz.supabase.co
# VITE_SUPABASE_ANON_KEY = anon public / publishable key (eyJ... หรือ sb_publishable_...)
#
# ห้ามใส่ค่าเดียวกันทั้งสองตัว
# ห้ามใส่ service_role
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
