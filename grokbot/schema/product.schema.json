{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rachawei.vercel.app/schemas/catalog-product.json",
  "title": "RachaweiCatalogProduct",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "category", "images"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "รหัสสินค้า เช่น \"12\""
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["พิเศษ", "เก้าอี้", "ทรงกลม", "ทรงเหลี่ยม", "มีฝา", "หูจับสูง"]
    },
    "special": { "type": "boolean" },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "ชื่อไฟล์ภายใต้ public/products/ เท่านั้น ไม่ใส่ /products/"
      }
    },
    "panorama360": {
      "type": "string",
      "description": "ชื่อไฟล์พาโนรามาภายใต้ public/products/"
    }
  }
}
