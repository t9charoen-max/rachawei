{
  "buildCommand": "npm run build",
  "installCommand": "npm ci && npm ci --prefix next-app",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"next-deploy\" ]; then exit 0; fi; case \"$VERCEL_PROJECT_PRODUCTION_URL$VERCEL_URL\" in *rachawei-f1it*) exit 0 ;; esac; git diff HEAD^ HEAD --quiet -- . && exit 0 || exit 1",
  "redirects": [
    { "source": "/rajawasu", "destination": "/rachawatsadu", "permanent": true },
    { "source": "/rajawasu/", "destination": "/rachawatsadu/", "permanent": true },
    { "source": "/rajawasu/:path*", "destination": "/rachawatsadu/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/desk", "destination": "/desk/index.html" },
    { "source": "/store", "destination": "/store/index.html" },
    { "source": "/rachawei-surin", "destination": "/store/index.html" },
    { "source": "/rachawatsadu", "destination": "/rachawatsadu/index.html" },
    { "source": "/rachawatsadu/products/:slug", "destination": "/rachawatsadu/products/:slug.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/products/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/store/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/rachawatsadu/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/desk/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/desk/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/desk/" }
      ]
    }
  ]
}
